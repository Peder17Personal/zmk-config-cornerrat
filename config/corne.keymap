#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Home {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  æ  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp D  &kp R      &kp W      &kp B    &kp J  &kp F          &kp U         &kp P       &none      &kp ENTER
&kp TAB    &kp A  &kp S  &kp H      &kp T      &kp G    &kp Y  &kp N          &kp E         &kp O       &kp I      &kp DELETE
&kp LSHFT  &kp Z  &kp X  &kp M      &kp C      &kp V    &kp K  &kp L          &kp COMMA     &kp PERIOD  &kp MINUS  &kp LESS_THAN
                         &kp LCTRL  &kp SPACE  &mo 1    &mo 2  &kp BACKSPACE  &kt LEFT_ALT
            >;
        };

        Num {
            bindings = <
&kp ESC    &none       &none           &kp UP_ARROW     &kp F4           &none    &bl BL_TOG    &none     &none         &none  &mt A B          &kp RET
&kp TAB    &trans      &kp LEFT_ARROW  &kp DOWN         &kp RIGHT        &to 5    &bl BL_CYCLE  &none     &none         &none  &rgb_ug RGB_TOG  &kp DEL
&kp LSHFT  &bl BL_TOG  &bl BL_CYCLE    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &mo 4    &none         &none     &none         &none  &rgb_ug RGB_EFF  &kp LESS_THAN
                                       &kp LCTRL        &kp SPACE        &none    &to 3         &kp BSPC  &kp LEFT_ALT
            >;
        };

        fun {
            bindings = <
&kp ESCAPE      &kp EXCLAMATION  &kp AT_SIGN       &kp HASH        &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp SLASH        &kp KP_NUMBER_7  &kt KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS   &kp ENTER
&kp TAB         &kp AMPERSAND    &kp EQUAL         &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp ASTERISK     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS  &kp DELETE
&kp LEFT_SHIFT  &kp LESS_THAN    &kp GREATER_THAN  &kp PERCENT     &kp LEFT_BRACE        &kp RIGHT_BRACE          &kt KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp COMMA  &kp LESS_THAN
                                                   &kp C_NEXT      &kp SPACE             &to 3                    &none            &kp BACKSPACE    &kp LEFT_ALT
            >;
        };

        qwert {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R      &kp T    &kp Y   &kp U     &kp I         &kp O    &kp P   &kp RET
&kp TAB    &kp A  &kp S  &kp D      &kp F      &kp G    &kp H   &kp J     &kp K         &kp L    &trans  &kp DEL
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V      &kp B    &kp N   &kp M     &kp COMMA     &kp DOT  &kp LT  &kp LESS_THAN
                         &kp LCTRL  &kp SPACE  &to 0    &trans  &kp BSPC  &kp LEFT_ALT
            >;
        };

        Control {
            bindings = <
&kp ESC    &trans      &trans      &trans          &trans       &trans               &trans  &trans    &trans    &trans  &trans  &kp RET
&kp TAB    &trans      &trans      &trans          &trans       &trans               &trans  &trans    &trans    &trans  &trans  &kp DEL
&kp LSHFT  &bt BT_PRV  &bt BT_NXT  &bt BT_CLR_ALL  &bootloader  &ext_power EP_TOG    &trans  &trans    &trans    &trans  &trans  &kp LT
                                   &kp LCTRL       &kp SPACE    &to 0                &trans  &kp BSPC  &kp LGUI
            >;
        };

        FUN {
            bindings = <
&kp ESC    &trans     &trans  &trans     &trans     &trans    &trans  &trans    &trans    &trans  &kp K   &kp RET
&kp TAB    &trans     &trans  &trans     &trans     &trans    &trans  &trans    &trans    &trans  &trans  &kp DEL
&kp LSHFT  &kp LSHFT  &trans  &trans     &trans     &trans    &trans  &trans    &trans    &trans  &trans  &kp LS(SEMI)
                              &kp LCTRL  &kp SPACE  &to 0     &trans  &kp BSPC  &kp LGUI
            >;
        };
    };
};
