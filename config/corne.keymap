#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Home {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  æ  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp D  &kp R      &kp W      &kp B    &kp J  &kp F          &kp U         &kp P       &none      &kp ENTER
&kp TAB    &kp A  &kp S  &kp H      &kp T      &kp G    &kp Y  &kp N          &kp E         &kp O       &kp I      &kp DELETE
&kp LSHFT  &kp Z  &kp X  &kp M      &kp C      &kp V    &kp K  &kp L          &kp COMMA     &kp PERIOD  &kp MINUS  &kp LESS_THAN
                         &kp LCTRL  &kp SPACE  &mo 1    &mo 2  &kp BACKSPACE  &kt LEFT_WIN
            >;
        };

        Num {
            bindings = <
&kp ESC    &to 3       &to 4           &kp UP_ARROW     &kp F4           &kp F5    &kp FSLH  &kp N7    &kp N8    &kp N9  &kp PLUS   &kp RET
&kp TAB    &trans      &kp LEFT_ARROW  &kp DOWN         &kp RIGHT        &trans    &kp STAR  &kp N4    &kp N5    &kp N6  &kp MINUS  &kp DEL
&kp LSHFT  &bl BL_TOG  &bl BL_CYCLE    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans    &kp N0    &kp N1    &kp N2    &kp N3  &kp COMMA  &kp LESS_THAN
                                       &kp LCTRL        &kp SPACE        &none     &kp BSPC  &kp BSPC  &kp LGUI
            >;
        };

        fun {
            bindings = <
&kp ESCAPE      &trans  &trans         &kp UP_ARROW      &trans       &trans    &trans  &trans         &trans        &trans  &trans  &kp ENTER
&kp TAB         &trans  &kp LEFT       &kp DOWN          &kp RIGHT    &trans    &trans  &trans         &trans        &trans  &trans  &kp DELETE
&kp LEFT_SHIFT  &trans  &kt PAGE_DOWN  &kp C_PLAY_PAUSE  &kp PAGE_UP  &trans    &trans  &trans         &trans        &trans  &trans  &kp LESS_THAN
                                       &kp LCTRL         &kp SPACE    &to 0     &trans  &kp BACKSPACE  &kp LEFT_WIN
            >;
        };

        qwert {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R      &kp T    &kp Y   &kp U     &kp I      &kp O    &kp P   &kp RET
&kp TAB    &kp A  &kp S  &kp D      &kp F      &kp G    &kp H   &kp J     &kp K      &kp L    &trans  &kp DEL
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V      &kp B    &kp N   &kp M     &kp COMMA  &kp DOT  &kp LT  &kp LESS_THAN
                         &kp LCTRL  &kp SPACE  &to 0    &trans  &kp BSPC  &kp LGUI
            >;
        };

        layer_4 {
            bindings = <
&kp ESC    &trans      &trans      &trans     &trans     &trans    &trans  &trans    &trans    &trans  &trans  &kp RET
&kp TAB    &trans      &trans      &trans     &trans     &trans    &trans  &trans    &trans    &trans  &trans  &kp DEL
&kp LSHFT  &bt BT_PRV  &bt BT_NXT  &trans     &trans     &trans    &trans  &trans    &trans    &trans  &trans  &kp LT
                                   &kp LCTRL  &kp SPACE  &to 0     &trans  &kp BSPC  &kp LGUI
            >;
        };
    };
};
