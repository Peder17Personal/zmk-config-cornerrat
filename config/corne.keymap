#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Home {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  æ  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp D  &kp R      &kp W      &kp B    &kp J  &kp F          &kp U         &kp P       &kp P      &kp ENTER
&kp TAB    &kp A  &kp S  &kp H      &kp T      &kp G    &kp Y  &kp N          &kp E         &kp O       &kp I      &kp LCTRL
&kp LSHFT  &kp Z  &kp X  &kp M      &kp C      &kp V    &kp K  &kp L          &kp COMMA     &kp PERIOD  &kp MINUS  &kp LESS_THAN
                         &kp LCTRL  &kp SPACE  &mo 1    &mo 2  &kp BACKSPACE  &kt LEFT_WIN
            >;
        };

        Num {
            bindings = <
&kp ESC    &kp F1      &kp F2        &kp F3           &kp F4           &kp F5    &kp FSLH  &kp N7    &kp N8    &kp N9  &kp PLUS   &kp RET
&kp TAB    &trans      &trans        &trans           &trans           &trans    &kp STAR  &kp N4    &kp N5    &kp N6  &kp MINUS  &kp DEL
&kp LSHFT  &bl BL_TOG  &bl BL_CYCLE  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans    &kp N0    &kp N1    &kp N2    &kp N3  &kp COMMA  &trans
                                     &kp LCTRL        &kp SPACE        &to 0     &kp BSPC  &kp BSPC  &kp LGUI
            >;
        };

        qwert {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R      &kp T     &kp Y   &kp U     &kp I      &kp O    &kp P   &kp RET
&kp TAB    &kp A  &kp S  &kp D      &kp F      &kp G     &kp H   &kp J     &kp K      &kp L    &trans  &kp DEL
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V      &kp B     &kp N   &kp M     &kp COMMA  &kp DOT  &kp LT  &trans
                         &kp LCTRL  &kp SPACE  &trans    &trans  &kp BSPC  &kp LGUI
            >;
        };
    };
};
